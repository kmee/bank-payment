<odoo>
    <record id="account_payment_api_line_close_form" model="ir.ui.view">
        <field name="model">account.payment.api.line.close</field>
        <field name="arch" type="xml">
            <form>
                <p>The bank gave no identifier for this payment, so Odoo cannot ask
                    about it. Nothing is sent to the bank: this only records what you
                    found there.</p>
                <group>
                    <field name="line_id" invisible="1" />
                    <field name="partner_id" />
                    <field name="amount" />
                    <field name="currency_id" invisible="1" />
                    <field name="outcome" widget="radio" />
                    <field name="reason" />
                    <field name="checked" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Close Payment"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
